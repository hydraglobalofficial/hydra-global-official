# ── Core ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Hosted Postgres (Neon, Supabase, Prisma Postgres…).
# DATABASE_URL: pooled connection used by the app at runtime.
# DIRECT_URL:   direct connection used by migrations and seeding.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
# Connections per server instance. Defaults to 3 on Vercel, 10 elsewhere.
DATABASE_POOL_MAX=""

# ── Admin auth ────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-a-32+-char-random-string"
# Required to create admin accounts at /admin/register (min 16 chars).
ADMIN_MASTER_KEY="replace-with-a-16+-char-random-master-key"
# Set to 1 only when intentionally onboarding new staff. First owner bootstrap works without this.
ADMIN_REGISTRATION_ENABLED=""
# Used only by `pnpm db:seed` to create the first owner account.
SEED_ADMIN_EMAIL="admin@hydra.com.bd"
SEED_ADMIN_USERNAME="owner"
SEED_ADMIN_PASSWORD="ChangeMe!2026"

# Public JSON catalog at /api/products — leave empty/off for storefront-only sites.
PUBLIC_CATALOG_API=""

# ── Redis (Upstash) ───────────────────────────────────────────────────
# Free at https://console.upstash.com — powers admin cache + rate limits.
# Optional in local dev: without these, an in-memory fallback is used.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Cloudflare R2 (admin image uploads) ───────────────────────────────
# Create a bucket + API token (Object Read & Write) in Cloudflare R2.
# Enable public access (r2.dev subdomain or custom domain) and paste that base URL.
# Without these, admin "Upload from device" returns 503; paste URLs still work.
# R2_ACCOUNT_ID = 32-char hex only (from the S3 API endpoint host). NOT the full URL.
# Wrong: https://abcd….r2.cloudflarestorage.com/hydra
# Right:  abcd1234… (the part before .r2.cloudflarestorage.com)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="hydra"
# Public base URL with no trailing slash, e.g. https://pub-xxxxx.r2.dev
R2_PUBLIC_URL=""

# ── Analytics (loaded only after cookie consent) ──────────────────────
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# ── Payments (fill when merchant accounts are approved) ───────────────
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_SANDBOX="true"

# ── SMTP (order invoice emails — fill when ready; app works without) ──
# Sent when admin sets an order status to CONFIRMED. Invoice UID = order number.
# Example Gmail: host smtp.gmail.com, port 587, app password as SMTP_PASS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASS=""
# From header, e.g. "HYDRA <orders@yourdomain.com>"
SMTP_FROM=""
SMTP_FROM_NAME="HYDRA"
SMTP_REPLY_TO=""

# ── Courier (scaffold — leave empty until API keys arrive) ────────────
# Invoice / consignment reference = order.number (same UID emailed to customer).
# COURIER_PROVIDER=steadfast
COURIER_PROVIDER=""
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""
STEADFAST_BASE_URL="https://portal.packzy.com/api/v1"
