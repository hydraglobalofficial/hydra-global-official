# ── Core ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Postgres. On a VPS use the box's own database (docker compose or apt postgres).
# DATABASE_URL: app runtime. DIRECT_URL: migrations + seed. Same string is fine
# when Postgres is local (no Neon pooler).
DATABASE_URL="postgresql://hydra:CHANGE_ME@127.0.0.1:5432/hydra"
DIRECT_URL="postgresql://hydra:CHANGE_ME@127.0.0.1:5432/hydra"
# Hosted Neon (optional): use the pooler URL for DATABASE_URL and the direct
# URL for DIRECT_URL, with sslmode=verify-full.
# Connections per Node process. Use 10–20 on a VPS; leave empty for defaults.
DATABASE_POOL_MAX=""
# Compose-only: password + RAID bind for the Postgres volume.
POSTGRES_DB="hydra"
POSTGRES_USER="hydra"
POSTGRES_PASSWORD="replace-with-a-strong-db-password"
# RAID / extra disk. Empty = ./data/postgres next to the repo.
POSTGRES_DATA_DIR=""

# ── File uploads ──────────────────────────────────────────────────────
# Empty / r2 = Cloudflare R2 when R2_* are set (keep this if the token is Read & Write).
# local = VPS disk (UPLOAD_DIR / RAID). Only set this if you want to skip R2.
STORAGE_DRIVER=""
# Absolute path on the RAID / data disk. Empty = ./uploads in the repo.
# VPS example: /mnt/raid/hydra/uploads
UPLOAD_DIR=""

# ── Admin auth ────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-a-32+-char-random-string"
# Required to create admin accounts at /admin/register. One key can create as many admins as you want.
ADMIN_MASTER_KEY="replace-with-a-16+-char-random-master-key"
# Unused. Registration stays open and checks ADMIN_MASTER_KEY only.
ADMIN_REGISTRATION_ENABLED=""
# Used only by `pnpm db:seed` to create the first owner account.
SEED_ADMIN_EMAIL="admin@hydra.com.bd"
SEED_ADMIN_USERNAME="owner"
SEED_ADMIN_PASSWORD="ChangeMe!2026"

# Public JSON catalog at /api/products — leave empty/off for storefront-only sites.
PUBLIC_CATALOG_API=""

# ── Redis ─────────────────────────────────────────────────────────────
# VPS: install redis-server and use REDIS_URL. It must listen on 127.0.0.1 only.
# Production login and checkout refuse to run if neither Redis is configured.
# Local dev falls back to memory when both are empty.
REDIS_URL="redis://127.0.0.1:6379"
# Optional cloud Redis. If both Upstash vars are set, they are used instead of REDIS_URL.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Cloudflare R2 (optional — only if STORAGE_DRIVER=r2) ──────────────
# VPS + RAID: leave these empty and keep STORAGE_DRIVER=local.
# Create a bucket + API token (Object Read & Write) in Cloudflare R2.
# Enable public access (r2.dev subdomain or custom domain) and paste that base URL.
# R2_ACCOUNT_ID = 32-char hex only (from the S3 API endpoint host). NOT the full URL.
# Wrong: https://abcd….r2.cloudflarestorage.com/hydra
# Right:  abcd1234… (the part before .r2.cloudflarestorage.com)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="hydra"
# Public base URL with no trailing slash, e.g. https://pub-xxxxx.r2.dev
R2_PUBLIC_URL=""

# ── Analytics (prefer Admin → SEO & tracking; env is fallback) ────────
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""

# ── Payments (fill when merchant accounts are approved) ───────────────
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_SANDBOX="true"

# ── SMTP (order invoice emails — sent when admin confirms an order) ──
# Hostinger: smtp.hostinger.com · port 465 · SSL (or 587 + SMTP_SECURE=false for STARTTLS)
# Username = full mailbox email that exists in Hostinger (e.g. business@hydraglobalofficial.com).
# Prefer Hostinger → Mailboxes → ⋮ → App passwords for SMTP_PASSWORD (more reliable than webmail password).
# SMTP_PASSWORD wins over SMTP_PASS when both are set. Always quote: SMTP_PASSWORD="…"
# App reads .env raw so $ in passwords is not eaten by Next.js dotenv-expand.
# Verify: pnpm mail:test   |   Admin → Courier → Test SMTP login
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="business@hydraglobalofficial.com"
SMTP_PASS=""
SMTP_PASSWORD=""
SMTP_FROM="HYDRA <business@hydraglobalofficial.com>"
SMTP_FROM_NAME="HYDRA"
SMTP_REPLY_TO="business@hydraglobalofficial.com"

# ── Courier (Pathao) ─────────────────────────────────────────────────
# Invoice / merchant_order_id = order.number (same UID emailed to customer).
# Confirm order in admin → books Pathao + emails invoice with /track?order=ID link.
COURIER_PROVIDER="pathao"
PATHAO_BASE_URL="https://api-hermes.pathao.com"
PATHAO_CLIENT_ID=""
PATHAO_CLIENT_SECRET=""
# Merchant panel login (required for OAuth token)
PATHAO_USERNAME=""
PATHAO_PASSWORD=""
# Numeric store id from Pathao merchant panel (auto-picks first store if empty)
PATHAO_STORE_ID=""
# Required for POST /api/webhooks/pathao (header x-pathao-signature or Authorization Bearer)
PATHAO_WEBHOOK_SECRET=""

# Optional fallback courier
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""
STEADFAST_BASE_URL="https://portal.packzy.com/api/v1"
   