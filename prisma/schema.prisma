// HYDRA data model.
// Money is stored as whole BDT (Int). Bangladeshi retail pricing has no sub-taka
// amounts, and integers avoid Decimal serialization across the RSC boundary.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity ────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  STAFF
  CUSTOMER
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders  Order[]
  reviews Review[]
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

enum DeviceBrand {
  APPLE
  SAMSUNG
}

model Device {
  id       String      @id @default(cuid())
  brand    DeviceBrand
  series   String // "iPhone 17", "Galaxy S25"
  model    String // "iPhone 17 Pro Max", "Galaxy S25 Ultra"
  slug     String      @unique
  position Int         @default(0)

  products ProductDevice[]

  @@index([brand, position])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  icon        String?
  position    Int        @default(0)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")

  products Product[]
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  tagline        String?
  description    String
  price          Int
  compareAtPrice Int?
  sku            String        @unique
  stock          Int           @default(0)
  featured       Boolean       @default(false)
  status         ProductStatus @default(DRAFT)
  highlights     String[]
  specs          Json          @default("{}")
  ratingAverage  Float         @default(0)
  ratingCount    Int           @default(0)
  soldCount      Int           @default(0)
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  images     ProductImage[]
  variants   ProductVariant[]
  devices    ProductDevice[]
  reviews    Review[]
  orderItems OrderItem[]

  @@index([status, featured])
  @@index([categoryId])
}

model ProductDevice {
  productId String
  deviceId  String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  device    Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([productId, deviceId])
  @@index([deviceId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductVariant {
  id            String  @id @default(cuid())
  productId     String
  name          String // "Clear", "Privacy", "Matte"
  sku           String  @unique
  priceOverride Int?
  stock         Int     @default(0)
  position      Int     @default(0)
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  orderItems OrderItem[]

  @@index([productId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id         String       @id @default(cuid())
  productId  String
  userId     String?
  authorName String
  rating     Int // 1–5, enforced in application validation
  title      String?
  comment    String
  verified   Boolean      @default(false)
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, status])
}

// ─── Commerce ────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  SSLCOMMERZ
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

model Order {
  id              String        @id @default(cuid())
  number          String        @unique
  userId          String?
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentRef      String?
  customerName    String
  email           String
  phone           String
  address         String
  country         String        @default("Bangladesh")
  city            String
  area            String?
  postalCode      String?
  notes           String?
  subtotal        Int
  shippingFee     Int
  discount        Int           @default(0)
  total           Int
  fulfillmentNote String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  items OrderItem[]

  @@index([status, createdAt])
  @@index([email])
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  productId   String
  variantId   String?
  // Snapshots so historic orders survive catalog edits.
  name        String
  variantName String?
  sku         String
  unitPrice   Int
  quantity    Int
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ─── Engagement & content ────────────────────────────────────────────────────

enum InquiryType {
  CONTACT
  SUPPORT
  WARRANTY
  RETURN
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

model Inquiry {
  id          String        @id @default(cuid())
  type        InquiryType   @default(CONTACT)
  status      InquiryStatus @default(NEW)
  name        String
  email       String
  phone       String?
  subject     String?
  orderNumber String?
  message     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
}

enum SubscriberStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

model Subscriber {
  id           String           @id @default(cuid())
  email        String           @unique
  status       SubscriberStatus @default(PENDING)
  token        String           @unique
  subscribedAt DateTime         @default(now())
  confirmedAt  DateTime?
}

model Announcement {
  id       String  @id @default(cuid())
  message  String
  href     String?
  position Int     @default(0)
  active   Boolean @default(true)
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  summary   String?
  body      String // Lightweight markdown: "## heading", "- item", paragraphs.
  updatedAt DateTime @updatedAt
}

/** Editable storefront section copy (About, home blocks, etc). */
model SiteSection {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  data      Json
  updatedAt DateTime @updatedAt
}
